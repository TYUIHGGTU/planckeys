{
  "name": "planckeys-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PlanckKeys 键盘控制台：网页里同时控灯（WebHID）与实时改键（Web Serial + ZMK Studio RPC）。",
  "scripts": {
    "dev": "vite",
    "build": "npm --prefix ../codex-bridge run build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm --prefix ../codex-bridge run build && tsc -b --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@zmkfirmware/zmk-studio-ts-client": "^0.0.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-hid": "^1.0.6",
    "@types/w3c-web-serial": "^1.0.6",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "eslint": "^9.15.0",
    "postcss": "^8.5.20",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
