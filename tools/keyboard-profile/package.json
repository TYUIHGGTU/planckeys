{
  "name": "@planckeys/keyboard-profile",
  "version": "0.1.0",
  "private": true,
  "description": "键盘设备 profile：LED 几何、键→灯映射、HID 匹配；改键物理布局仍由 ZMK Studio RPC 提供。",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
