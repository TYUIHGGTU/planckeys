{
  "name": "planckeys-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Passive monitor that reflects Codex activity from any terminal CLI and the desktop app on Planckeys' RGB LEDs via codex hooks + Raw HID (usage page 0xFF60), reproducing the Codex Micro 6-thread status wall.",
  "type": "module",
  "bin": {
    "codex-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mock": "tsx src/index.ts --mock",
    "install-hooks": "node dist/index.js install-hooks codex",
    "install-hooks:codebuddy": "node dist/index.js install-hooks codebuddy",
    "install-hooks:workbuddy": "node dist/index.js install-hooks workbuddy",
    "install-hooks:claude": "node dist/index.js install-hooks claude",
    "uninstall-hooks": "node dist/index.js uninstall-hooks codex",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "node-hid": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
