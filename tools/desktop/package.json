{
  "name": "@planckeys/desktop",
  "productName": "Planckeys",
  "version": "0.1.0",
  "private": true,
  "description": "Planckeys 菜单栏 App：以子进程方式监管 agent-bridge 守护进程，支持开机自启，免去每次命令行启动（第一阶段）。",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/run-dev.mjs",
    "dev": "npm run build && node scripts/run-dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "typescript": "^5.7.2"
  }
}
