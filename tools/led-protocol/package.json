{
  "name": "@planckeys/led-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Planckeys Raw HID 线材协议（报文命令与打包）。LED 几何见 @planckeys/keyboard-profile。",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@planckeys/keyboard-profile": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
