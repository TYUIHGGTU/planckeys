#include "planck.dtsi"
#include <dt-bindings/led/led.h>

/ {
	EXT_POWER {
		compatible = "zmk,ext-power-generic";
		control-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		init-delay-ms = <50>;
	};
};

&pinctrl {
    spi2_default: spi2_default {
				group1 {
						psels = <NRF_PSEL(SPIM_MOSI, 0, 20)>,
						<NRF_PSEL(SPIM_SCK, 0, 24)>;
				};
		};
	
    spi2_sleep: spi2_sleep {
				group1 {
						psels = <NRF_PSEL(SPIM_MOSI, 0, 20)>,
						<NRF_PSEL(SPIM_SCK, 0, 24)>;
						low-power-enable;
				};
		};

    spi3_default: spi3_default {
				group1 {
						psels = <NRF_PSEL(SPIM_MOSI, 0, 13)>;
				};
		};
	
    spi3_sleep: spi3_sleep {
				group1 {
						psels = <NRF_PSEL(SPIM_MOSI, 0, 13)>;
						low-power-enable;
				};
		};
};


lpm_view_spi: &spi2 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >;
};

nice_view_spi: &spi2 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) >;
};


&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
				compatible ="worldsemi,ws2812-spi";
        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <28>; /* arbitrary; change at will */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
		};
};
// 独立后不再需要把右板拼到合并变换的右半，故去掉 col-offset，
// 并覆盖 map：右板底排在 col 0..3（编码器键在 col 3）。
&default_transform {
	map = <
		RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
		RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
		RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
		RC(3,0) RC(3,1) RC(3,2) RC(3,3)
	>;
};
&right_encoder {
    status = "okay";
};

&sensors {
	sensors = <&right_encoder>;
};

/ {
	chosen {
		zmk,physical-layout = &right_physical_layout;
    zmk,underglow = &led_strip;
	};

	// 右板：整体顺时针旋转 90°（4 列 x 6 行）。
	// new_x = (4-1) - row, new_y = col。位置顺序同（覆盖后的）default_transform。
	right_physical_layout: right_physical_layout {
		compatible = "zmk,physical-layout";
		display-name = "PlanckKeys Right";
		transform = <&default_transform>;
		kscan = <&kscan0>;
		keys  //                     w   h    x    y   rot   rx   ry
			= <&key_physical_attrs 100 100  300    0     0    0    0>
			, <&key_physical_attrs 100 100  300  100     0    0    0>
			, <&key_physical_attrs 100 100  300  200     0    0    0>
			, <&key_physical_attrs 100 100  300  300     0    0    0>
			, <&key_physical_attrs 100 100  300  400     0    0    0>
			, <&key_physical_attrs 100 100  300  500     0    0    0>
			, <&key_physical_attrs 100 100  200    0     0    0    0>
			, <&key_physical_attrs 100 100  200  100     0    0    0>
			, <&key_physical_attrs 100 100  200  200     0    0    0>
			, <&key_physical_attrs 100 100  200  300     0    0    0>
			, <&key_physical_attrs 100 100  200  400     0    0    0>
			, <&key_physical_attrs 100 100  200  500     0    0    0>
			, <&key_physical_attrs 100 100  100    0     0    0    0>
			, <&key_physical_attrs 100 100  100  100     0    0    0>
			, <&key_physical_attrs 100 100  100  200     0    0    0>
			, <&key_physical_attrs 100 100  100  300     0    0    0>
			, <&key_physical_attrs 100 100  100  400     0    0    0>
			, <&key_physical_attrs 100 100  100  500     0    0    0>
			, <&key_physical_attrs 100 100    0    0     0    0    0>
			, <&key_physical_attrs 100 100    0  100     0    0    0>
			, <&key_physical_attrs 100 100    0  200     0    0    0>
			, <&key_physical_attrs 100 100    0  300     0    0    0>
			;
	};

	kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <4>;
        columns = <12>;

        wakeup-source;

        // Include the matrix driver
        matrix {
            kscan = <&kscan1>;
        };

        // Include the direct GPIO driver...
        direct {
            kscan = <&kscan2>;
						row-offset=<3>;
            col-offset = <3>; // ...and shift it to not overlap
        };
    };
    kscan1: kscan_matrix {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
				col-gpios
						  =   <&gpio0 30 (GPIO_ACTIVE_HIGH )>
								, <&gpio0 31 (GPIO_ACTIVE_HIGH )>
								, <&gpio0 28 (GPIO_ACTIVE_HIGH)>
								, <&gpio0 29 (GPIO_ACTIVE_HIGH)>
								, <&gpio0 2 (GPIO_ACTIVE_HIGH)>
								, <&gpio1 13 (GPIO_ACTIVE_HIGH)>;
    };
     kscan2: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
				wakeup-source;
				input-gpios 
			    = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
