if BOARD_PLANCK_LEFT

config ZMK_KEYBOARD_NAME
		default "PlanckKeys L"

endif

if BOARD_PLANCK_RIGHT

config ZMK_KEYBOARD_NAME
		default "PlanckKeys R"

endif

if BOARD_PLANCK_LEFT || BOARD_PLANCK_RIGHT
#
# config BOARD
# 		default "AU"

# 两块板已改造为各自独立的完整键盘（不再是左主右从分体），
# 因此不再开启 ZMK_SPLIT / ZMK_SPLIT_ROLE_CENTRAL。

config BT_CTLR
		default BT

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

if ZMK_DISPLAY

# config I2C
#     default y
#
# config SSD1306
#     default y

# config LPM009M360A
# 	default n
endif # ZMK_DISPLAY


if LVGL
config ZMK_DISPLAY_DEDICATED_THREAD_STACK_SIZE
	default 8192

#config LV_HOR_RES_MAX
	#default 128
#config LV_VER_RES_MAX
	#default 32
config LV_Z_VDB_SIZE
	default 64

config LV_DPI_DEF
	default 148
config LV_Z_BITS_PER_PIXEL
	default 1
choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

# config ZMK_WIDGET_WPM_STATUS
# 	default y
choice BOARD_CHARGER_CURRENT
    default BOARD_CHARGER_CURRENT_100MA
endchoice

config I2C
	default y
config SPI
	default y

endif 
