# 仓库根 ZMK 模块配置：自研 WS2812 灯带控制（网页每颗 RGB + 预设灯效）。

config PLANCKEYS_LED_CONTROL
	bool "planckeys web-controlled WS2812 LED (takes over the strip)"
	depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
	select RAW_HID
	select LED_STRIP
	help
	  自研模块独占 zmk,underglow 指向的 WS2812 灯带：
	  - 主机经 Raw HID (usage page 0xFF60) 下发每颗独立 RGB / 纯色 / 亮度；
	  - 内建预设灯效：常亮 / 呼吸 / 跑马 / 熔灭 / 关灯；
	  - keymap 里的 &led_next 键循环切换上述预设。
	  使用前请在 <board>.conf 里关闭 CONFIG_ZMK_RGB_UNDERGLOW，避免两者
	  争抢同一条灯带。

if PLANCKEYS_LED_CONTROL

config PLANCKEYS_LED_DEFAULT_BRIGHTNESS
	int "Default brightness (0-255)"
	default 80

config PLANCKEYS_LED_AXIS_START
	int "Chain index where the per-key (axis) LEDs start"
	default 6
	help
	  已确认布局（单条链 28 颗）：index 0..5 为底灯（正面不可见），
	  index 6..27 为每键轴灯。此值仅用于日志/观感（如跑马方向），
	  不影响基础功能。

config PLANCKEYS_LED_FRAME_MS
	int "Animation frame period in milliseconds"
	default 33

endif # PLANCKEYS_LED_CONTROL
